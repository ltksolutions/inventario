# =============================================================================
# Inventario — Environment Variables (Template)
# =============================================================================
#
# 1. Skopíruj tento súbor:  cp .env.example .env
#    (apps/api číta aj `apps/api/.env.local`, ak existuje)
# 2. Vyplň skutočné hodnoty — NIKDY ich nedávaj do gitu
# 3. Produkčné hodnoty patria do Vercel dashboardu, nie sem
#
# ZDROJ PRAVDY je Zod schéma v `apps/api/src/plugins/config.ts`. Ak appka
# pri boote spadne na "Environment validation failed", pozri sa tam.
# Každý nový kľúč doplň do `config.ts`, do tohto súboru AJ do
# `turbo.json` → `globalEnv` (inak ho Turborepo do buildu nepustí).
#
# Legenda:  [povinné] = bez toho sa API nespustí
#           [voliteľné] = bez toho beží, ale dotknutá funkcia vracia 503
# =============================================================================


# ─────────────────────────────────────────────────────────────────────
# General
# ─────────────────────────────────────────────────────────────────────

NODE_ENV=development                    # development | test | production
LOG_LEVEL=debug                         # trace|debug|info|warn|error|fatal|silent (default: info)
PORT=3000                               # port API servera (default: 3000)


# ─────────────────────────────────────────────────────────────────────
# MongoDB  [MONGO_URI povinné]
# ─────────────────────────────────────────────────────────────────────

MONGO_URI=mongodb://admin:changeme-local-only@localhost:27017/inventario?authSource=admin
MONGO_DB_NAME=inventario                # default: inventario

# Produkcia (MongoDB Atlas):
# MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/inventario?retryWrites=true&w=majority

# Prihlasovacie údaje pre lokálny Mongo kontejner z infra/docker-compose.yml.
# Musia súhlasiť s MONGO_URI vyššie.
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme-local-only


# ─────────────────────────────────────────────────────────────────────
# API server (apps/api)
# ─────────────────────────────────────────────────────────────────────

# Odkiaľ smie prehliadač volať API. Buď '*' (len skorý dev!), alebo
# zoznam originov oddelený čiarkou. Default: http://localhost:3001
CORS_ORIGINS=http://localhost:3001

# Kam API presmeruje po dokončení OAuth prihlásenia. Default: http://localhost:3001
FRONTEND_BASE_URL=http://localhost:3001

# Verejná base URL tohto API. Zapisuje sa do brandKit.logoUrl pri nahratí
# loga (ADR-0037), takže odkaz musí platiť aj mimo requestu, ktorý ho
# vytvoril — číta ho generátor PDF protokolov (beží aj z cronu), scan
# stránka a web.
#
# Na Verceli MUSÍ byť nastavená na https://api.inventario.estate. Default
# nižšie je pre lokálny vývoj; keby zostal v produkcii, logá by odkazovali
# na localhost.
PUBLIC_API_BASE_URL=http://localhost:3000

# Swagger UI na /docs. Default je odvodený od NODE_ENV — v produkcii false.
ENABLE_SWAGGER=true


# ─────────────────────────────────────────────────────────────────────
# Web app (apps/web — Next.js, beží na porte 3001)
# ─────────────────────────────────────────────────────────────────────
#
# POZOR: NEXT_PUBLIC_* sa zapekajú do buildu, nie čítajú za behu.
# Po ich zmene treba web prebuildovať.

NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_CANONICAL_APP_URL=http://localhost:3001
NEXT_PUBLIC_APPLE_ENABLED=false          # zobraziť tlačidlo Sign in with Apple


# ─────────────────────────────────────────────────────────────────────
# Inventario JWT (ADR-0013)  [voliteľné lokálne, povinné v produkcii]
# ─────────────────────────────────────────────────────────────────────
#
# RS256 pár na podpis vlastných access tokenov. Bez nich beží JWT služba
# v stub režime a prihlásenie nefunguje. Vygeneruj:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -in private.pem -pubout -out public.pem
# Do env sa dáva OBSAH súborov (PEM vrátane -----BEGIN/END----- riadkov).

# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
JWT_ACCESS_TOKEN_TTL_SECONDS=900         # default 900 (15 min)
JWT_REFRESH_TOKEN_TTL_DAYS=30            # default 30


# ─────────────────────────────────────────────────────────────────────
# OAuth poskytovatelia (ADR-0013, ADR-0031)  [voliteľné]
# ─────────────────────────────────────────────────────────────────────
#
# Bez OAUTH_STATE_SECRET a OAUTH_REDIRECT_BASE_URL sa OAuth routy
# vôbec nezaregistrujú.

# OAUTH_STATE_SECRET=                    # min. 32 znakov, openssl rand -hex 32
# OAUTH_REDIRECT_BASE_URL=http://localhost:3000/v1/auth/callback

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# Apple Sign-In (ADR-0013 K4) — Services ID, Team ID, Key ID, obsah .p8
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# Šifrovanie per-tenant OAuth secretov v DB (ADR-0031). Bez toho ukladanie
# tenantových OAuth údajov vracia 503; platformové premenné vyššie fungujú.
# 64 hex znakov: openssl rand -hex 32
# OAUTH_SECRET_ENCRYPTION_KEY=


# ─────────────────────────────────────────────────────────────────────
# TOTP MFA (Slice #7)  [voliteľné — bez toho MFA endpointy vracajú 503]
# ─────────────────────────────────────────────────────────────────────
#
# AES-256-GCM kľúč na šifrovanie TOTP secretov v DB. 64 hex znakov.
# Generuj: openssl rand -hex 32

# MFA_SECRET_ENCRYPTION_KEY=


# ─────────────────────────────────────────────────────────────────────
# WebAuthn / Passkeys (ADR-0016)  [voliteľné — bez toho 503]
# ─────────────────────────────────────────────────────────────────────
#
# RP ID musí súhlasiť s efektívnou doménou originu. Lokálne 'localhost',
# v produkcii 'inventario.estate'.

# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=Inventario
# WEBAUTHN_EXPECTED_ORIGINS=http://localhost:3001


# ─────────────────────────────────────────────────────────────────────
# E-mail (lokál: stub alebo MailHog, prod: Ecomail)
# ─────────────────────────────────────────────────────────────────────

EMAIL_PROVIDER=stub                      # ecomail | resend | stub (default: stub)
EMAIL_FROM_ADDRESS=noreply@inventario.estate
EMAIL_FROM_NAME="Inventario"
# EMAIL_REPLY_TO=support@inventario.estate

# Povinné, keď EMAIL_PROVIDER=ecomail
# (Manage your account → For developers → Copy API Key)
# ECOMAIL_API_KEY=

# Povinné, keď EMAIL_PROVIDER=resend. Formát: re_xxxxxxxx
# RESEND_API_KEY=


# ─────────────────────────────────────────────────────────────────────
# Vercel Blob — dva story (public ADR-0028, private ADR-0037)
# ─────────────────────────────────────────────────────────────────────
#
# Nahrávanie príloh a loga organizácie ide cez @vercel/blob. Bez tokenu
# tie endpointy zlyhajú. Vo Verceli je premenná nastavená pre všetky
# prostredia; lokálne si ju vytvor v Vercel dashboarde (Storage → Blob).

# BLOB_READ_WRITE_TOKEN=

# Originály príloh idú do PRIVATE storu `inventario-private` (iad1) podľa
# ADR-0037 — každé čítanie aj zápis vyžaduje autentifikáciu.
#
# Prefix je BLOB_PRIVATE_, nie BLOB_, aby nekolidoval s tokenom public
# storu vyššie. Token sa SDK predáva VŽDY explicitne: pri chýbajúcom
# tokene by si @vercel/blob vzal BLOB_READ_WRITE_TOKEN a originály by
# skončili vo verejnom store. Preto sa OIDC cesta nepoužíva — s dvoma
# pripojenými storami ju ani nie ako rozlíšiť.
#
# Na Verceli premenné doplňa Storage → inventario-private → Connect
# Project (prefix BLOB_PRIVATE, so zaškrtnutým read-write tokenom).
# Bez tokenu beží úložisko v stub režime (prílohy len v pamäti procesu).
# BLOB_PRIVATE_READ_WRITE_TOKEN=
# BLOB_PRIVATE_STORE_ID=


# ─────────────────────────────────────────────────────────────────────
# Servisné endpointy /v1/system  [voliteľné — bez toho vracajú 503]
# ─────────────────────────────────────────────────────────────────────
#
# MIGRATIONS_SECRET — volá ho .github/workflows/migrate-on-deploy.yml
#   na POST /v1/system/migrations/run a /v1/system/indexes/ensure.
# CRON_SECRET       — volá ho Vercel cron na POST /v1/system/retention/run
#   (mesačne, GDPR retencia). Vo Verceli sa nastavuje sám.
# Obidve min. 32 znakov, zámerne rôzne (iný spúšťač, iná rotácia).
# Generuj: openssl rand -hex 32

# MIGRATIONS_SECRET=
# CRON_SECRET=


# ─────────────────────────────────────────────────────────────────────
# Legacy — Microsoft Entra ID
# ─────────────────────────────────────────────────────────────────────
#
# Z auth flow odstránené v Slice #6c K17. `config.ts` ich stále prijíma
# ako voliteľné, aby staršie .env.local nepadali pri boote. Nové
# prostredie ich nepotrebuje.

# ENTRA_TENANT_ID=
# ENTRA_API_CLIENT_ID=
# ENTRA_ISSUER=
# ENTRA_JWKS_URI=
# TEST_JWT_PUBLIC_KEY=
