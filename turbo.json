{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "build/**"],
      "env": ["NODE_ENV"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": ["NODE_ENV"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**", "test-results/**"],
      "env": ["NODE_ENV", "BASE_URL"]
    },
    "clean": {
      "cache": false
    }
  },
  "globalDependencies": [".env", "tsconfig.base.json"],
  "globalEnv": [
    "CI",
    "NODE_ENV",
    "MONGO_URI",
    "MONGO_DB_NAME",
    "CORS_ORIGINS",
    "LOG_LEVEL",
    "ENABLE_SWAGGER",
    "PORT",
    "ENTRA_TENANT_ID",
    "ENTRA_API_CLIENT_ID",
    "ENTRA_JWKS_URI",
    "TEST_JWT_PUBLIC_KEY",
    "JWT_PRIVATE_KEY",
    "JWT_PUBLIC_KEY",
    "JWT_ACCESS_TOKEN_TTL_SECONDS",
    "JWT_REFRESH_TOKEN_TTL_DAYS",
    "OAUTH_STATE_SECRET",
    "OAUTH_REDIRECT_BASE_URL",
    "EMAIL_PROVIDER",
    "EMAIL_FROM_ADDRESS",
    "EMAIL_FROM_NAME",
    "EMAIL_REPLY_TO",
    "ECOMAIL_API_KEY",
    "RESEND_API_KEY",
    "MFA_SECRET_ENCRYPTION_KEY",
    "WEBAUTHN_RP_ID",
    "WEBAUTHN_RP_NAME",
    "WEBAUTHN_EXPECTED_ORIGINS",
    "CRON_SECRET"
  ]
}
