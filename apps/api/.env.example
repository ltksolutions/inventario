# ============================================================================
# Inventario — API environment variables
# ============================================================================
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# For Vercel deployment, set these in:
#   Vercel Dashboard → Project → Settings → Environment Variables
#
# NEVER commit .env.local or .env to git (already in .gitignore).
# ============================================================================

# --- Application ---
# 'development' enables pino-pretty logs, dev-only routes
# 'production' enables strict validation, structured JSON logs
NODE_ENV=development

# Port for local development (Vercel ignores this in production)
PORT=3000

# Log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=debug

# --- MongoDB Atlas ---
# Get from: https://cloud.mongodb.com → Cluster → Connect → Drivers
# Format: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://inventario-api:CHANGE_ME@inventario-dev.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Database name (will be created automatically on first write)
MONGO_DB_NAME=inventario

# --- CORS ---
# Comma-separated list of allowed origins (frontend URLs)
# For local dev: include http://localhost:3001 (apps/web default port)
# For production: https://app.inventario.estate, https://*.inventario.estate
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# --- Cookies ---
# Domain for auth cookies (inv_access, inv_refresh).
# Must start with a dot to cover all subdomains: .inventario.estate
# Leave unset for local development (cookies will be set without domain).
# Required for production — without this, login will not work on HTTPS.
# Fork: set this to your own domain, e.g. .your-domain.com
# COOKIE_DOMAIN=.inventario.estate

# --- Auth (Entra ID) ---
# Get these from Azure Portal → Entra ID → App registrations → "Inventario API".
#
# ENTRA_TENANT_ID:
#   Directory (tenant) ID — visible on Overview page of any app registration
#   or under Entra ID → Overview. Format: GUID (UUID v4).
#
# ENTRA_API_CLIENT_ID:
#   Application (client) ID of the API app registration (NOT the CLI/SPA client).
#   Format: GUID. The JWT's `aud` claim must equal this value (or `api://<guid>`).
#
# Both required — the server refuses to start without them.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_API_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Optional overrides — derived automatically from ENTRA_TENANT_ID if omitted.
# Only set these for non-public Azure clouds (e.g. Azure Government).
# ENTRA_ISSUER=https://login.microsoftonline.com/${ENTRA_TENANT_ID}/v2.0
# ENTRA_JWKS_URI=https://login.microsoftonline.com/${ENTRA_TENANT_ID}/discovery/v2.0/keys

# CLI app client ID — ONLY used by scripts/dev-auth-test.sh for fetching
# test tokens via device code flow. NOT consumed by the API server itself.
# Create a separate public-client app registration in Azure for this.
# ENTRA_CLI_CLIENT_ID=00000000-0000-0000-0000-000000000000

# --- Feature flags ---
# Enable Swagger UI at /docs (recommended for dev/staging, disable for prod)
ENABLE_SWAGGER=true

# --- OAuth providers (ADR-0013 + ADR-0030) ---
# OAUTH_STATE_SECRET: 32+ char random string for signing state cookies.
#   Generate: openssl rand -hex 32
# OAUTH_REDIRECT_BASE_URL: Base URL for OAuth callbacks (API, not frontend).
#   Local dev: http://localhost:3000/v1/auth/callback
#   Production: https://api.inventario.estate/v1/auth/callback
# FRONTEND_BASE_URL: Used for post-OAuth redirects.
#   Local dev: http://localhost:3001
#   Production: https://app.inventario.estate

# OAUTH_STATE_SECRET=change_me_generate_with_openssl_rand_hex_32
# OAUTH_REDIRECT_BASE_URL=http://localhost:3000/v1/auth/callback
# FRONTEND_BASE_URL=http://localhost:3001

# Google OAuth
# Create credentials at: https://console.cloud.google.com → APIs & Services → Credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Microsoft OAuth (multi-tenant, accepts any MS account)
# App registration at: https://portal.azure.com → Entra ID → App registrations
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# Apple Sign-In (ADR-0030 D1) — requires Apple Developer account (enrollment pending)
# Setup: https://developer.apple.com → Certificates, Identifiers & Profiles
#   1. Create an App ID with "Sign in with Apple" capability
#   2. Create a Services ID (e.g. sk.inventario.estate.signin) — this is APPLE_CLIENT_ID
#   3. Configure the Services ID with redirect URL: https://api.inventario.estate/v1/auth/callback/apple
#   4. Create a private key with "Sign in with Apple" enabled — download .p8 file
#   5. Note the Key ID and Team ID from your developer account
#
# APPLE_CLIENT_ID=sk.inventario.estate.signin  (Services ID)
# APPLE_TEAM_ID=XXXXXXXXXX                      (10-char Team ID)
# APPLE_KEY_ID=XXXXXXXXXX                       (Key ID from the .p8 key)
# APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
#   (paste full .p8 content; replace newlines with \n in Vercel env var)

# --- MFA secret encryption (Slice #7) ---
# 64 hex chars (32 bytes). Generate: openssl rand -hex 32
# MFA_SECRET_ENCRYPTION_KEY=

# --- OAuth client secret encryption (ADR-0031) ---
# Separate from MFA_SECRET_ENCRYPTION_KEY (principle of least privilege).
# 64 hex chars (32 bytes). Generate: openssl rand -hex 32
# If unset, per-tenant Microsoft OAuth credentials cannot be saved;
# platform env fallback (MICROSOFT_CLIENT_ID) still works.
# OAUTH_SECRET_ENCRYPTION_KEY=
