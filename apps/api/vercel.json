{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff --name-only HEAD^ HEAD | grep -qvE '^docs/' && exit 1 || exit 0",
  "buildCommand": "cd ../.. && pnpm install --frozen-lockfile && pnpm --filter @inventario/shared-types build",
  "outputDirectory": ".",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": "src/modules/protocols/assets/**"
    }
  },
  "crons": [
    {
      "path": "/v1/system/retention/run",
      "schedule": "0 3 1 * *"
    },
    {
      "path": "/health/ready",
      "schedule": "*/4 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
