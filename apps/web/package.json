{
  "name": "@inventario/web",
  "version": "0.1.0",
  "private": true,
  "description": "Inventario · Frontend webová aplikácia (inventario.sportup.sk/app). Next.js 15 + TanStack Query + Tailwind + shadcn/ui.",
  "license": "EUPL-1.2",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3001",
    "prebuild": "pnpm generate:api-types",
    "build": "next build",
    "start": "next start --port 3001",
    "prelint": "pnpm generate:api-types",
    "lint": "eslint src --max-warnings 0",
    "pretypecheck": "pnpm generate:api-types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "generate:api-types": "openapi-typescript ../api/openapi.json -o src/lib/api-types.ts",
    "clean": "rm -rf .next .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@inventario/design-tokens": "workspace:*",
    "@inventario/shared-types": "workspace:*",
    "@simplewebauthn/browser": "^13.3.0",
    "@tanstack/react-query": "^5.102.8",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "~15.5.24",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.5.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "openapi-typescript": "^7.4.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  },
  "engines": {
    "node": "24.x"
  },
  "keywords": [
    "inventario",
    "frontend",
    "nextjs",
    "react",
    "tailwind",
    "multi-tenant"
  ]
}
